rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{scoreId} {
      function incoming() {
        return request.resource.data;
      }
      function isOwnScoreDoc() {
        return request.auth != null
          && incoming().uid == request.auth.uid
          && scoreId == request.auth.uid + '_' + incoming().mapId + '_' + incoming().difficulty;
      }
      function isValidScore() {
        return incoming().keys().hasOnly(['uid', 'name', 'mapId', 'difficulty', 'timeSec', 'createdAt'])
          && incoming().uid is string
          && incoming().name is string
          && incoming().name.size() >= 1
          && incoming().name.size() <= 20
          && incoming().mapId is string
          && incoming().mapId.size() >= 1
          && incoming().mapId.size() <= 40
          && incoming().difficulty in ['easy', 'normal', 'hard', 'extreme']
          && incoming().timeSec is int
          && incoming().timeSec > 0
          && incoming().timeSec < 86400
          && incoming().createdAt == request.time;
      }

      allow read: if true;
      allow create: if isOwnScoreDoc() && isValidScore();
      allow update: if isOwnScoreDoc() && isValidScore()
        && incoming().timeSec < resource.data.timeSec;
      allow delete: if false;
    }
  }
}
